{
  "icon": "./logo-large.webp",
  "name": "pvue-syntax",
  "displayName": "PHPue Syntax Highlighter",
  "version": "0.0.1",
  "publisher": "PHPue",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "pvue",
        "aliases": ["PVue", "pvue"],
        "extensions": [".pvue"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "path": "./syntaxes/pvue.tmLanguage.json",
        "scopeName": "source.pvue",
        "language": "pvue"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PHPue/PHPue-SyntaxHighlighter"
  }
}
